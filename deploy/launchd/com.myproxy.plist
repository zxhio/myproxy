<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.myproxy</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/myproxy/bin/myproxy</string>
        <string>-c</string>
        <string>/opt/myproxy/etc/myproxy.conf</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>WorkingDirectory</key>
    <string>/opt/myproxy</string>

    <key>StandardOutPath</key>
    <string>/opt/myproxy/log/stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/opt/myproxy/log/stderr.log</string>

    <key>ThrottleInterval</key>
    <integer>3</integer>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
</dict>
</plist>